# Agent Assist service settings. Copy to .env (git-ignored) next to this file and fill in what you need.
# Real environment variables win over .env, so a deployment can set any of these in its unit or container
# instead. Defaults are what the service uses when a line is left out. ciap/config.py documents each one.

# ── CIP mode: ciap-api ───────────────────────────────────────────────────────────
# ciap-api's base URL. Set: each tenant's catalog and every call's state come from ciap-api, so the service
# keeps nothing between turns and any number of instances can serve a call. Unset: the built-in catalog and
# in-memory call state (local development, the demo and the tests only).
CIAP_API_BASE_URL=http://localhost:8080
# Sent to ciap-api as X-Api-Key: must equal ciap-api's AGENT_ASSIST_INTERNAL_API_KEY.
CIAP_API_KEY=change-me
# The longest one request to ciap-api waits, in seconds.
#CIAP_API_TIMEOUT_SECONDS=5
# Backstop for turns without a catalog_version: the longest a cached tenant catalog is used, in seconds.
#CATALOG_MAX_AGE_SECONDS=300

# ── Inbound auth ─────────────────────────────────────────────────────────────────
# Every /v1 request must send this as X-Api-Key. Must equal AGENT_ASSIST_API_KEY in ciap-api and ciap-kafka.
# Unset: open, for local development only.
AGENT_ASSIST_API_KEY=change-me

# ── LLM (Ollama) ─────────────────────────────────────────────────────────────────
# Ollama's address (read by the ollama client). Without Ollama the service still matches intents, fills
# slots and runs tools; only LLM answers and escalations fall back.
#OLLAMA_HOST=http://127.0.0.1:11434
# The model that writes the agent's answer from a live tool's result.
#RESPONDER_MODEL_NAME=gemma4:e2b-it-qat
# focused (a sentence or two) or full (a paragraph).
#RESPONDER_DEFAULT_MODE=focused
# The longest a turn waits for a focused / full answer before falling back to a plain listing, in seconds.
# 20 covers a large record on a CPU-only box; on a GPU these can come down.
#RESPONDER_TIMEOUT_SECONDS=20
#RESPONDER_FULL_TIMEOUT_SECONDS=40
# The longest an LLM escalation (ambiguous intent, multi-intent, correction) waits, in seconds.
#LLM_ESCALATION_TIMEOUT_SECONDS=10
# How long Ollama keeps the answer model loaded after a call, in seconds; -1 = always.
#RESPONDER_KEEP_ALIVE_SECONDS=-1
# true: send the model only the parts of a tool result closest to the call (faster). false: the whole result.
#RESPONDER_PRUNE_RESULTS=true
# How many items of a result list are compared with the call to pick what the model sees (~15 ms each on CPU).
#RESPONDER_MAX_SCORED_ITEMS=50
# The answer model's context window in tokens. Unset: Ollama's default when pruning, 32768 when not.
#RESPONDER_NUM_CTX=

# ── Live tools (MCP) ─────────────────────────────────────────────────────────────
# The named MCP connections file. Its URLs and tokens are "${NAME}" references, filled from the variables
# below (or the environment).
#MCP_CONNECTIONS_PATH=connections.json
# Saved MCP OAuth sign-ins (one <name>.json per connection; they hold tokens: keep readable by the service only).
#MCP_TOKENS_DIR=data/oauth
# The longest a turn waits for a remote tool call (or tool listing) before a tool error, in seconds.
#MCP_CALL_TIMEOUT_SECONDS=5
# A tenant's MCP session unused this many seconds is closed; the next call opens a new one.
#MCP_SESSION_IDLE_SECONDS=600
# CIP mode requires https MCP servers on public addresses; true lifts that (local development only).
#MCP_ALLOW_PRIVATE_HOSTS=false

# Secrets referenced by connections.json. Only the connections you use need values.
#ZOHO_MCP_URL=
#ZOHO_OAUTH_MCP_URL=
#ZOHO_OAUTH_CLIENT_ID=
#ZOHO_OAUTH_CLIENT_SECRET=
#HUBSPOT_CLIENT_ID=
#HUBSPOT_CLIENT_SECRET=
#HELPDESK_MCP_URL=
#HELPDESK_API_KEY=
#SHOP_MCP_URL=
#SHOP_ACCESS_TOKEN=
#ERP_MCP_URL=
#ERP_CLIENT_ID=
#ERP_CLIENT_SECRET=
#SALESFORCE_MCP_URL=
#SF_CLIENT_ID=
#SF_CLIENT_SECRET=
#SF_REFRESH_TOKEN=
#LEGACY_CRM_SSE_URL=
#LEGACY_CRM_TOKEN=
#BILLING_API_KEY=
#ORDERS_DB_URL=

# ── Turns and calls ──────────────────────────────────────────────────────────────
# A turn that calls a tool claims it first; a second copy of that turn waits this long for the first, in seconds.
#TURN_IN_PROGRESS_WAIT_SECONDS=30
# A claim older than this many seconds is treated as abandoned (the instance holding it died).
#TURN_CLAIM_STALE_SECONDS=120
# Built-in mode only: a call idle this many seconds is dropped from memory; 0 = never.
#CALL_IDLE_TIMEOUT_SECONDS=1800

# ── Optional features (off by default) ───────────────────────────────────────────
# The agent slot-correction endpoint (PATCH …/frames/{frame_id}/slots/{slot_name}; out of scope this release).
#SLOT_OVERRIDE_ENABLED=false
# The browser demo at /demo (dev or demo boxes only).
#DEMO_UI_ENABLED=false

# ── Embedding model ──────────────────────────────────────────────────────────────
# 1 = never contact Hugging Face (the model must already be downloaded; the Docker image bakes it in).
#HF_HUB_OFFLINE=1
